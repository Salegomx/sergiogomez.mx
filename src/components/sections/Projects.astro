---
import { getCollection, render } from "astro:content";
import ProjectCard from "@components/ProjectCard.astro";

// Filename prefix (1-, 2-, …) controls display order
const projects = (await getCollection("projects")).sort((a, b) =>
    a.id.localeCompare(b.id, undefined, { numeric: true })
);
---
<section id="projects" class="content__section">
    <div class="content__container">
        <h2 class="heading">My Work</h2>
        <p class="subheading">Real-world projects that reflect my approach to design and development.</p>
        <div class="grid">
            {projects.map(async (project) => {
                const { Content } = await render(project);
                return (
                    <ProjectCard {...project.data}>
                        <Content />
                    </ProjectCard>
                );
            })}
        </div>
    </div>
</section>
