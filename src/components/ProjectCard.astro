---
import type { ImageMetadata } from "astro";
import { Picture } from "astro:assets";
import { faArrowUpRightFromSquare } from "@fortawesome/free-solid-svg-icons";
import Icon from "@components/Icon.astro";

export interface Props {
    title: string;
    link?: string;
    img: ImageMetadata;
    tags: string[];
}

const { title, link, img, tags } = Astro.props;
---

<div class="card">
    <a href={link || "/"} target="_blank" title="Visit live site" aria-label="Visit live site">
        <Picture
            class="card__picture"
            src={img}
            alt={title}
            widths={[400, 600, 900, img.width]}
            sizes={"(max-width: 400px) 400px, (max-width: 768px) 600px, (max-width: 1200px) 900px"}
            inferSize={false}
            quality={"mid"}
            formats={["avif", "webp"]}
            fallbackFormat="jpg"
        />
    </a>
    <div class="card__content">
        <div class="card__title-container">
            <span class="card__title">{title}</span>
            <ul class="card__tags">
                {tags.map((tag) => (
                    <li class="card__tag">{tag}</li>
                ))}
            </ul>
        </div>
        <slot />
        <a class="card__link" href={link || "/"} target="_blank" title="Visit live site" aria-label="Visit live site">
            <span>Visit live site</span>
            <Icon icon={faArrowUpRightFromSquare} size={16} />
        </a>
    </div>
</div>