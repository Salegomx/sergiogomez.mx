---
import Nav from "@components/Nav.astro";
import Icon from "@components/Icon.astro";
import { Image } from "astro:assets";
import { faMoon, faSun } from "@fortawesome/free-solid-svg-icons";
import logo from "@assets/img/logo.svg";
import logoWhite from "@assets/img/logo_white.svg";

const themeIcons = [
	{ name: "sun", icon: faSun },
	{ name: "moon", icon: faMoon },
];
---

<header class="header">
	<div class="header__container">
		<a class="header__logo" href="/">
			<Image class="header__logo--light" src={logo} alt="Sergio Gómez" width="95" height="45" loading="eager"/>
			<Image class="header__logo--dark" src={logoWhite} alt="Sergio Gómez" width="95" height="45" loading="eager"/>
		</a>
		<div class="header__actions">
			<nav class="header__nav">
				<Nav />
			</nav>
			<button id="theme-toggle" class="theme-toggle" type="button" aria-label="Toggle theme">
				{themeIcons.map(({ name, icon }) => (
					<Icon class={`theme-toggle__icon--${name}`} icon={icon} />
				))}
			</button>
			<button id="header__menu-btn" class="mobile-only" aria-label="Menu">
				<span class="top"></span>
				<span class="middle"></span>
				<span class="bottom"></span>
			</button>
		</div>
	</div>
</header>